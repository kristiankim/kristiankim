---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  experiences,
  home,
  projects as fallbackProjects,
  thoughts as fallbackThoughts,
} from '../data/content';
import { getPosts, getProjects, urlFor } from '../lib/sanity';
import PlaygroundGallery from '../components/PlaygroundGallery.astro';
import { getPlayground } from '../lib/playground';
const latestPlayground = (await getPlayground()).slice(0, 3);

const sanityPosts = await getPosts();
const sanityProjects = await getProjects();

const writing = (sanityPosts.length
  ? sanityPosts.map((post) => ({
      slug: post.slug.current,
      title: post.title,
      category: post.category || 'Thoughts',
      publishedAt: (post.publishedAt || '').slice(0, 10),
    }))
  : fallbackThoughts.map((post) => ({
      slug: post.slug,
      title: post.title,
      category: post.category,
      publishedAt: post.publishedAt,
    }))
).sort((a, b) => (a.publishedAt < b.publishedAt ? 1 : -1));

const works = sanityProjects.length
  ? sanityProjects.map((project) => ({
      slug: project.slug.current,
      title: project.title,
      year: project.year || 'In progress',
      company: project.company || 'Independent',
      overview: project.overview || 'Details coming soon.',
      isPrivate: Boolean(project.isPrivate),
      coverImageUrl: project.cover?.asset ? urlFor(project.cover)?.width(1600).quality(85).url() : null,
      coverImageAlt: project.cover?.alt || project.title,
    }))
  : fallbackProjects.map((project) => ({
      slug: project.slug,
      title: project.title,
      year: project.year || 'In progress',
      company: project.company || 'Independent',
      overview: project.overview || 'Details coming soon.',
      isPrivate: Boolean(project.isPrivate),
      coverImageUrl: null,
      coverImageAlt: project.title,
    }));
---

<BaseLayout>
  <section class="home-hero twelve-col">
    <div class="hero-visual">
      <img
        src="/images/kristian-designing.svg"
        alt="Illustration of Kristian designing at his desk"
      />
    </div>
    <div class="hero-intro">
      <h1>{home.intro}</h1>
    </div>
    <div class="hero-body detail-copy">
      <p>{home.body}</p>
      <p set:html={home.longBio} />
    </div>
  </section>

  <section class="section-block">
    <div class="section-header">
      <div class="section-heading">Experiences</div>
    </div>
    <div class="works-list">
      {experiences.map((item) => (
        <article class="project-row">
          <div class="project-meta">
            <div class="project-company">{item.company}</div>
            <div class="project-year">
              <span>{item.period}</span>
            </div>
          </div>
          <div class="project-copy">
            <p class="project-summary">{item.summary}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="works" class="section-block">
    <div class="section-header">
      <a class="section-heading section-heading-link" href="/works"><span>Selected work</span><span class="section-heading-arrow" aria-hidden="true">→</span></a>
    </div>
    <div class="selected-work-list">
      {works.map((project) => (
        <article class="selected-work-card">
          <div class="selected-work-copy">
            <div class="selected-work-meta">
              <span>{project.company}</span>
              <span>{project.year}</span>
              {project.isPrivate && <span>Private</span>}
            </div>
            <div class="selected-work-text">
              <a class="selected-work-link" href={`/works/${project.slug}`}>{project.title}</a>
            </div>
          </div>
          <a
            class="selected-work-media-link"
            href={`/works/${project.slug}`}
            aria-label={`View ${project.title} case study`}
          >
            {project.coverImageUrl ? (
              <img class="selected-work-image" src={project.coverImageUrl} alt={project.coverImageAlt} loading="lazy" />
            ) : (
              <div class="selected-work-placeholder" aria-hidden="true"></div>
            )}
          </a>
        </article>
      ))}
    </div>
  </section>

  <section id="playground" class="section-block">
    <div class="section-header">
      <div class="playground-heading"><h2 class="section-heading">Playground</h2><a href="/playground">View all <span aria-hidden="true">→</span></a></div>
    </div>
    <p class="playground-intro">A few things from the worktable. Pick one up.</p>
    <PlaygroundGallery items={latestPlayground} id="home-playground" variant="preview" />
  </section>

  <section id="thoughts" class="section-block">
    <div class="section-header">
      <a class="section-heading section-heading-link" href="/thoughts"><span>Writings</span><span class="section-heading-arrow" aria-hidden="true">→</span></a>
    </div>
    <div class="writing-list">
      {writing.map((post) => (
        <article class="writing-row">
          <div class="writing-date">{post.publishedAt}</div>
          <div class="writing-category">{post.category}</div>
          <a class="writing-link" href={`/thoughts/${post.slug}`}>{post.title}</a>
        </article>
      ))}
    </div>
  </section>

</BaseLayout>

<style>
  .playground-intro { font-size: 15px; }
  .playground-heading { display: flex; justify-content: space-between; align-items: center; width: 100%; gap: 24px; }
  .playground-heading h2 { margin: 0; }
  .playground-heading > a { font-size: 14px; text-decoration: none; }
  .playground-heading > a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .home-hero {
    grid-template-rows: auto auto auto;
    row-gap: 80px;
    align-items: start;
    padding: 40px 0 24px;
  }

  .hero-intro,
  .hero-body,
  .hero-visual {
    align-self: start;
  }

  .hero-intro {
    grid-column: 1 / span 7;
  }

  .hero-intro h1 {
    font-size: 32px;
    line-height: 1.25;
  }

  .hero-body {
    grid-column: 6 / span 7;
  }

  .hero-visual {
    grid-column: 1 / -1;
    justify-self: center;
    width: min(486px, 100%);
    background: var(--page-bg);
  }

  .hero-visual img {
    width: 100%;
    aspect-ratio: 486 / 394;
    object-fit: contain;
    background: var(--page-bg);
  }

  .section-heading-link {
    color: inherit;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .section-heading-link:hover {
    color: var(--text);
  }

  .section-heading-arrow {
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .section-heading-link:hover .section-heading-arrow,
  .section-heading-link:focus-visible .section-heading-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .works-list,
  .writing-list,
  .selected-work-list {
    display: grid;
  }

  .project-row,
  .writing-row {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 24px;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
    align-items: start;
  }

  .project-meta {
    grid-column: 1 / span 4;
    display: grid;
    gap: 12px;
  }

  .project-copy {
    grid-column: 6 / span 7;
  }

  .writing-date {
    grid-column: 1 / span 2;
  }

  .writing-category {
    grid-column: 3 / span 2;
  }

  .writing-link {
    grid-column: 6 / span 7;
  }

  .project-row:last-child,
  .writing-row:last-child {
    border-bottom: 0;
  }

  .project-company,
  .writing-date,
  .writing-category {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.2857;
  }

  .project-company {
    font-family: var(--font-serif);
    font-size: 24px;
    line-height: 1.1667;
  }

  .project-year {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.2857;
  }

  .project-year {
    display: grid;
    gap: 2px;
  }

  .project-copy {
    display: grid;
    gap: 6px;
  }

  .project-summary {
    color: var(--text);
  }

  .project-copy a,
  .writing-link {
    color: var(--text);
    text-decoration: none;
    font-size: 16px;
    line-height: 1.375;
  }

  .project-copy a:hover,
  .writing-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .selected-work-list {
    gap: 24px;
  }

  .selected-work-card {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 24px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--line-strong);
    align-items: start;
  }

  .selected-work-card:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .selected-work-copy {
    grid-column: 1 / span 4;
    display: grid;
    gap: 16px;
  }

  .selected-work-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.2857;
  }

  .selected-work-text {
    display: grid;
    gap: 4px;
  }

  .selected-work-link {
    color: var(--text);
    text-decoration: none;
    font-size: 24px;
    line-height: 1.1667;
    font-family: var(--font-serif);
  }

  .selected-work-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .selected-work-media-link {
    grid-column: 6 / span 7;
    display: block;
    overflow: clip;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
  }

  .selected-work-media-link:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 4px;
  }

  .selected-work-image,
  .selected-work-placeholder {
    width: 100%;
    aspect-ratio: 550 / 344;
    object-fit: contain;
    transition: transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .selected-work-media-link:hover .selected-work-image,
  .selected-work-media-link:hover .selected-work-placeholder,
  .selected-work-media-link:focus-visible .selected-work-image,
  .selected-work-media-link:focus-visible .selected-work-placeholder {
    transform: scale(1.018);
  }

  .selected-work-media-link:active .selected-work-image,
  .selected-work-media-link:active .selected-work-placeholder {
    transform: scale(0.995);
  }

  .selected-work-placeholder {
    background:
      linear-gradient(135deg, rgba(23, 23, 23, 0.05), rgba(23, 23, 23, 0.12)),
      rgba(255, 255, 255, 0.6);
    border: 1px solid var(--line);
  }

  .personal-projects-section {
    overflow: visible;
  }

  .personal-marquee {
    width: 100%;
    overflow: hidden;
    padding: 4px 0 12px;
    mask-image: linear-gradient(to right, transparent 0, #000 7%, #000 93%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 7%, #000 93%, transparent 100%);
  }

  .personal-marquee-track {
    display: flex;
    width: max-content;
    animation: personal-marquee-scroll 34s linear infinite;
    will-change: transform;
  }

  .personal-marquee-group {
    display: flex;
    gap: 16px;
    padding-right: 16px;
  }

  .personal-preview-card {
    display: block;
    flex: 0 0 clamp(248px, 34vw, 360px);
    width: clamp(248px, 34vw, 360px);
    color: var(--text);
    text-decoration: none;
  }

  .personal-preview-media {
    overflow: clip;
    aspect-ratio: 4 / 3;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid var(--line);
  }

  .personal-preview-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .personal-preview-card:hover .personal-preview-media img,
  .personal-preview-card:focus-visible .personal-preview-media img {
    transform: scale(1.025);
  }

  .personal-preview-card:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 4px;
  }

  .personal-preview-card:active .personal-preview-media img {
    transform: scale(0.995);
  }

  .personal-marquee:hover .personal-marquee-track,
  .personal-marquee:focus-within .personal-marquee-track {
    animation-play-state: paused;
  }

  @keyframes personal-marquee-scroll {
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  .playground-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .playground-card {
    min-height: 495px;
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 40px;
    padding-top: 24px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #fff;
    overflow: clip;
  }

  .playground-card-copy {
    display: grid;
    gap: 8px;
    padding: 0 24px;
  }

  .playground-card-copy h2 {
    font-size: 24px;
    line-height: 1.1667;
  }

  .playground-card-copy p {
    height: 70px;
    overflow: hidden;
  }

  .playground-card-link {
    color: #1936ef;
    text-decoration: none;
    font-size: 16px;
    line-height: 1.375;
    width: fit-content;
  }

  .playground-card-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .playground-card-media {
    position: relative;
    min-height: 0;
    overflow: hidden;
  }

  .playground-browser {
    position: absolute;
    inset: auto auto -40px calc(50% + 6px);
    width: min(91%, 495px);
    aspect-ratio: 495 / 314;
    transform: translate3d(-50%, 0, 0);
    border: 4px solid #ddd;
    border-radius: 16px;
    background: #fff;
    box-shadow: -17px 28px 0 5px rgba(97, 97, 97, 0.15);
    overflow: hidden;
    transition:
      transform 220ms ease,
      box-shadow 220ms ease;
    will-change: transform, box-shadow;
  }

  .playground-browser-header {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 47px;
    padding: 0 18px;
    border-bottom: 1px solid #ececec;
    background: #f8f8f8;
  }

  .playground-browser-header span {
    width: 12px;
    height: 12px;
    border-radius: 999px;
    background: #d0d0d0;
  }

  .playground-browser img {
    width: 100%;
    height: calc(100% - 47px);
    object-fit: contain;
    object-position: center bottom;
    background: #f4f4f4;
  }

  .playground-card:hover .playground-browser {
    transform: translate3d(-50%, -8px, 0);
    box-shadow: -17px 36px 0 5px rgba(97, 97, 97, 0.18);
  }

  @media (max-width: 980px) {
    .home-hero {
      row-gap: 40px;
      padding-top: 24px;
    }

    .hero-intro,
    .hero-body,
    .hero-visual {
      grid-column: auto;
      max-width: none;
    }

    .hero-visual img {
      width: 100%;
      max-width: 486px;
      margin: 0 auto;
    }

    .project-row,
    .writing-row,
    .selected-work-card {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .project-meta,
    .project-copy,
    .writing-date,
    .writing-category,
    .writing-link {
      grid-column: auto;
    }

    .selected-work-media-link {
      grid-column: auto;
      min-height: 0;
    }

    .selected-work-copy {
      grid-column: auto;
    }

    .personal-marquee {
      width: calc(100% + 32px);
      margin-left: -16px;
    }

    .playground-grid {
      grid-template-columns: 1fr;
    }

    .playground-card {
      min-height: 0;
    }

    .playground-browser {
      position: relative;
      inset: auto;
      width: calc(100% - 32px);
      margin: 0 auto -12px;
      transform: none;
    }

    .playground-card:hover .playground-browser {
      transform: translateY(-6px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .personal-marquee {
      overflow-x: auto;
      mask-image: none;
      -webkit-mask-image: none;
      scrollbar-width: thin;
    }

    .personal-marquee-track {
      animation: none;
    }

    .personal-marquee-group[aria-hidden='true'] {
      display: none;
    }
  }
</style>
