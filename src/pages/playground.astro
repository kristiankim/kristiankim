---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlaygroundGallery from '../components/PlaygroundGallery.astro';
import { getPlayground } from '../lib/playground';
const items = await getPlayground();
---
<BaseLayout title="Playground" description="Interface experiments, small ideas, and things made out of curiosity by Kristian Kim.">
  <section class="playground-page">
    <header>
      <h1>Playground</h1>
      {items.length > 1 && (
        <button class="page-shuffle" type="button" data-shuffle-for="playground" aria-controls="playground-grid" hidden>
          <svg aria-hidden="true" viewBox="0 0 20 20" width="18" height="18" fill="none">
            <path d="M3 5h2.2c4.6 0 5.1 10 9.6 10H17m-3-3 3 3-3 3M3 15h2.2c1.8 0 2.9-1.5 4-3.4M14 2l3 3-3 3m3-3h-2.2c-1.8 0-2.9 1.5-4 3.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span>Shuffle</span>
        </button>
      )}
    </header>
    <PlaygroundGallery items={items} id="playground" externalControls />
  </section>
</BaseLayout>
<style>
  .playground-page { max-width: 960px; margin: 0 auto; padding: 64px 0 100px; }
  header { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; column-gap: 24px; row-gap: 14px; margin-bottom: 72px; }
  h1 { font-size: clamp(48px, 7vw, 80px); margin: 0; line-height: 1.1; }
  .page-shuffle { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 9px 15px; border: 1px solid var(--line-strong); border-radius: 24px; background: transparent; color: var(--text); font: inherit; font-size: 14px; cursor: pointer; }
  .page-shuffle:hover { background: #e5eddf; }
  .page-shuffle:focus-visible { outline: 2px solid var(--text); outline-offset: 3px; }
  .page-shuffle[hidden] { display: none; }
  @media (max-width: 560px) {
    .playground-page { padding-top: 32px; }
    header { column-gap: 12px; margin-bottom: 52px; }
    h1 { font-size: 40px; }
    .page-shuffle { padding-inline: 12px; }
  }
</style>
